# lawGEO 环境变量模板
# 部署到 Zeabur / Vercel / Railway 时，把这些填入服务的 Environment Variables 面板。
# 本地开发请复制为 .env.local 后填值。

# ── 数据库（SQLite 文件路径） ────────────────────────────────────────
# Zeabur：挂一个 Volume 到 /data，然后这里填 file:/data/lawgeo.db
DATABASE_URL="file:./data/lawgeo.db"

# ── 站点公开 URL（用于 schema.org canonical / 短链 / 邮件链接） ────
# 部署后改成实际域名，如 https://lawgeo.app
NEXT_PUBLIC_SITE_URL="http://localhost:4648"

# ── AI 模型：小米 MIMO Token Max Plan（必填） ────────────────────────
MIMO_API_KEY="tp-..."
MIMO_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
MIMO_BASE_URL_ANTHROPIC="https://token-plan-cn.xiaomimimo.com/anthropic"
MIMO_MODEL="mimo-v2.5-pro"

# ── Auth secret（必填，至少 32 字符随机串） ──────────────────────────
# 生成方法：openssl rand -hex 32
AUTH_SECRET=""

# ── OSS 集成（全部可选，详见 docs/oss-integration-research.md） ────
# LiteLLM 统一网关（OpenAI 兼容，自托管 github.com/BerriAI/litellm）
LLM_GATEWAY_URL=""
LLM_GATEWAY_KEY=""
LLM_GATEWAY_MODEL="deepseek/deepseek-chat"
# Firecrawl 网页抓取（自托管 github.com/firecrawl/firecrawl）
FIRECRAWL_API_URL=""
FIRECRAWL_API_KEY=""
# 真机答案抓取 Skyvern/Steel（出真截图证据链）
BROWSER_AGENT_URL=""
BROWSER_AGENT_KEY=""
# RAGFlow 深度知识库（github.com/infiniflow/ragflow）
RAGFLOW_API_URL=""
RAGFLOW_API_KEY=""
RAGFLOW_DATASET_ID=""
# Postiz 海外多平台发布（github.com/gitroomhq/postiz-app）
POSTIZ_API_URL=""
POSTIZ_API_KEY=""

# ── 真实多平台 AI key（可选；未配置则 fallback 到 MIMO 模拟） ───────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
DOUBAO_API_KEY=""
KIMI_API_KEY=""
ZHIPU_API_KEY=""
PERPLEXITY_API_KEY=""

# ── 邮件告警（Resend，可选） ─────────────────────────────────────────
RESEND_API_KEY=""
ALERT_FROM_EMAIL="lawGEO <no-reply@lawgeo.cn>"

# ── Cron secret（保护 /api/cron/run）────────────────────────────────
# 生成方法：openssl rand -hex 32
CRON_SECRET=""
